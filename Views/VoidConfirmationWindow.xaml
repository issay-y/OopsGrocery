<Window x:Class="OopsGrocery.Views.VoidConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Void Item Authorization"
        Width="460"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Inter, Segoe UI, Arial"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <SolidColorBrush x:Key="ForestBrush" Color="#1B4D2B"/>
        <SolidColorBrush x:Key="ForestHoverBrush" Color="#225933"/>
        <SolidColorBrush x:Key="YellowBrush" Color="#FFC926"/>
        <SolidColorBrush x:Key="InkBrush" Color="#1E293B"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderBrushLight" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="DangerRed" Color="#EF4444"/>
        <SolidColorBrush x:Key="DangerRedDark" Color="#DC2626"/>

        <Style x:Key="CloseIconBtn" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="15">
                            <TextBlock Text="✕" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="White"
            CornerRadius="16"
            BorderThickness="1"
            BorderBrush="#CBD5E1"
            Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26"
                              Direction="270"
                              Opacity="0.22"
                              ShadowDepth="4"
                              Color="#0F172A"/>
        </Border.Effect>

        <Grid Margin="0,0,0,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Item details -->
                <RowDefinition Height="Auto"/> <!-- PIN Input -->
                <RowDefinition Height="Auto"/> <!-- Validation Feedback -->
                <RowDefinition Height="Auto"/> <!-- Buttons -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="#FEF2F2"
                    CornerRadius="16,16,0,0"
                    BorderThickness="0,0,0,1"
                    BorderBrush="#FEE2E2"
                    Padding="22,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="38" Height="38"
                            Background="#FEE2E2"
                            CornerRadius="19"
                            Margin="0,0,12,0">
                        <TextBlock Text="🛡️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Void Confirmation"
                                   FontSize="17" FontWeight="Bold"
                                   Foreground="#991B1B"/>
                        <TextBlock Text="Manager or supervisor authorization required to void item"
                                   FontSize="11.5" Foreground="#B91C1C" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="2" Style="{StaticResource CloseIconBtn}" Click="CancelButton_OnClick"/>
                </Grid>
            </Border>

            <!-- Selected Product Name & Quantity Details -->
            <Border Grid.Row="1"
                    Background="#F8FAFC"
                    BorderBrush="{StaticResource BorderBrushLight}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,12"
                    Margin="22,16,22,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="SELECTED PRODUCT FOR VOID"
                                   FontSize="10.5" FontWeight="Bold"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="ProductNameText"
                                   Text="Product Name"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource InkBrush}"
                                   Margin="0,4,0,2"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="ProductCodeText"
                                   Text="Code: PRD-0001"
                                   FontSize="11.5" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="#FEF2F2" CornerRadius="6" Padding="8,4" HorizontalAlignment="Right">
                            <TextBlock x:Name="QuantityText"
                                       Text="Qty: 1"
                                       FontSize="12.5" FontWeight="Bold"
                                       Foreground="#DC2626"/>
                        </Border>
                        <TextBlock x:Name="ItemTotalText"
                                   Text="₱0.00"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource InkBrush}"
                                   HorizontalAlignment="Right"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Six-Digit PIN Input Section -->
            <StackPanel Grid.Row="2" Margin="22,0,22,0">
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="Enter 6-Digit Authorization PIN:"
                               FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}"/>
                    <TextBlock Text="(Default Supervisor PIN: 123456)"
                               HorizontalAlignment="Right"
                               FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                </Grid>

                <Border BorderBrush="{StaticResource BorderBrushLight}"
                        x:Name="PinBorder"
                        BorderThickness="1.5"
                        CornerRadius="8"
                        Background="#FFFFFF"
                        Padding="8,4">
                    <PasswordBox x:Name="PinPasswordBox"
                                 MaxLength="6"
                                 FontSize="22"
                                 FontWeight="Bold"
                                 HorizontalAlignment="Center"
                                 HorizontalContentAlignment="Center"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{StaticResource InkBrush}"
                                 PasswordChar="●"
                                 Width="180"
                                 PreviewTextInput="PinPasswordBox_OnPreviewTextInput"
                                 PasswordChanged="PinPasswordBox_OnPasswordChanged"
                                 KeyDown="PinPasswordBox_OnKeyDown"/>
                </Border>
            </StackPanel>

            <!-- Validation Feedback -->
            <Border Grid.Row="3" Margin="22,8,22,0"
                    x:Name="ValidationFeedbackBorder"
                    Visibility="Collapsed"
                    Background="#FEF2F2"
                    BorderBrush="#FECACA"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,6">
                <TextBlock x:Name="ValidationFeedbackText"
                           Text="PIN must be exactly 6 numeric digits."
                           FontSize="11.5" FontWeight="SemiBold"
                           Foreground="#DC2626"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- Action Buttons -->
            <Grid Grid.Row="4" Margin="22,18,22,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Cancel"
                        Height="40"
                        Background="#F1F5F9"
                        Foreground="{StaticResource InkBrush}"
                        FontWeight="SemiBold"
                        FontSize="13"
                        BorderBrush="{StaticResource BorderBrushLight}"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="CancelButton_OnClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#E2E8F0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Grid.Column="2"
                        Content="Confirm Void"
                        Height="40"
                        Background="{StaticResource DangerRed}"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="13"
                        Cursor="Hand"
                        Click="ConfirmVoidButton_OnClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{StaticResource DangerRedDark}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
