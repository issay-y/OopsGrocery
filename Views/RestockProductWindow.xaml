<Window x:Class="OopsGrocery.Views.RestockProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restock Inventory Item"
        Width="520"
        MaxHeight="800"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Inter, Segoe UI, Arial"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <SolidColorBrush x:Key="ForestBrush" Color="#1B4D2B"/>
        <SolidColorBrush x:Key="ForestHoverBrush" Color="#225933"/>
        <SolidColorBrush x:Key="YellowBrush" Color="#FFC926"/>
        <SolidColorBrush x:Key="YellowHoverBrush" Color="#F6BE14"/>
        <SolidColorBrush x:Key="InkBrush" Color="#1E293B"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderBrushLight" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="CardStrokeBrush" Color="#C5CDD8"/>
        <SolidColorBrush x:Key="PillGreenBg" Color="#DCFCE7"/>
        <SolidColorBrush x:Key="PillGreenText" Color="#166534"/>
        <SolidColorBrush x:Key="PillAmberBg" Color="#FEF3C7"/>
        <SolidColorBrush x:Key="PillAmberText" Color="#92400E"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="InputFrame" TargetType="Border">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,0"/>
        </Style>

        <Style x:Key="BareTextBox" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        </Style>

        <Style x:Key="QuickChipButton" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="{StaticResource ForestBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="18">
                            <TextBlock Text="✕" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryModalButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ForestBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ForestHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryModalButton" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Border Background="White" CornerRadius="14" BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#0F172A" Opacity="0.25" BlurRadius="20" ShadowDepth="5" Direction="270"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="26,24,20,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24" Background="{StaticResource PillAmberBg}" VerticalAlignment="Center">
                        <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{StaticResource PillAmberText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Text="Restock Inventory Item" FontSize="20" FontWeight="Bold" Foreground="{StaticResource ForestBrush}"/>
                        <TextBlock Text="Add stock quantity to existing inventory balance." FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource CloseIconButtonStyle}" Click="CloseButton_OnClick"/>
                </Grid>

                <Separator Grid.Row="0" VerticalAlignment="Bottom" Background="{StaticResource BorderBrushLight}"/>

                <!-- Body -->
                <StackPanel Grid.Row="1" Margin="26,20,26,20">
                    <!-- Item Info Card -->
                    <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="ItemNameText" FontSize="15" FontWeight="Bold" Foreground="{StaticResource InkBrush}"/>
                                <TextBlock x:Name="ItemCategoryText" FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="Current Stock" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="CurrentStockText" FontSize="18" FontWeight="Bold" Foreground="{StaticResource ForestBrush}" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Inline Validation Banner -->
                    <Border x:Name="ValidationErrorBanner"
                            Visibility="Collapsed"
                            Background="#FEF2F2"
                            BorderBrush="#FCA5A5"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="⚠️" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="ValidationErrorMessage"
                                       Grid.Column="1"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="#B91C1C"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Quantity to Add -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Quantity to Add *"/>
                        <Border x:Name="QuantityBorder" Style="{StaticResource InputFrame}">
                            <TextBox x:Name="AddQuantityInput" Style="{StaticResource BareTextBox}" Text="25"
                                     MaxLength="8"
                                     PreviewTextInput="AddQuantityInput_OnPreviewTextInput"
                                     PreviewKeyDown="NumericInput_OnPreviewKeyDown"
                                     TextChanged="AddQuantityInput_OnTextChanged"/>
                        </Border>
                    </StackPanel>

                    <!-- Quick Preset Buttons -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <TextBlock Text="Quick presets:" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Content="+10" Style="{StaticResource QuickChipButton}" Click="QuickPreset_OnClick" Tag="10"/>
                        <Button Content="+25" Style="{StaticResource QuickChipButton}" Click="QuickPreset_OnClick" Tag="25"/>
                        <Button Content="+50" Style="{StaticResource QuickChipButton}" Click="QuickPreset_OnClick" Tag="50"/>
                        <Button Content="+100" Style="{StaticResource QuickChipButton}" Click="QuickPreset_OnClick" Tag="100"/>
                    </StackPanel>

                    <!-- Resulting Stock Preview -->
                    <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="14,12">
                        <Grid VerticalAlignment="Center">
                            <TextBlock Text="Resulting Stock Balance:" FontSize="13.5" FontWeight="SemiBold" Foreground="#065F46" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ResultingStockText" FontSize="16" FontWeight="Bold" Foreground="#047857" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Footer -->
                <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="0,1,0,0" CornerRadius="0,0,13,13" Padding="26,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Cancel" Style="{StaticResource SecondaryModalButton}" Click="CancelButton_OnClick"/>
                        <Button Grid.Column="2" Content="Confirm Restock" IsDefault="True" Style="{StaticResource PrimaryModalButton}" Click="ConfirmButton_OnClick"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
