<UserControl x:Class="OopsGrocery.Views.AdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <SolidColorBrush x:Key="ForestBrush" Color="#1B4D2B"/>
        <SolidColorBrush x:Key="YellowBrush" Color="#FFC926"/>
        <SolidColorBrush x:Key="YellowHoverBrush" Color="#F6BE14"/>
        <SolidColorBrush x:Key="InkBrush" Color="#222222"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#666666"/>
        <SolidColorBrush x:Key="BorderBrushLight" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PillGreenBg" Color="#DCFCE7"/>
        <SolidColorBrush x:Key="PillGreenText" Color="#166534"/>
        <SolidColorBrush x:Key="PillAmberBg" Color="#FEF3C7"/>
        <SolidColorBrush x:Key="PillAmberText" Color="#92400E"/>

        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>

        <Style x:Key="SmallActionButton" TargetType="Button">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="{StaticResource ForestBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushLight}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,32">
            <!-- Header section -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Store Management &amp; Analytics"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource ForestBrush}"/>
                    <TextBlock Text="Real-time grocery inventory, order pipeline, and performance metrics."
                               FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="📊 Export Report"
                        Command="{Binding QuickExportCommand}"
                        Background="{StaticResource ForestBrush}"
                        Foreground="White"
                        FontWeight="SemiBold"
                        FontSize="12.5"
                        Padding="16,8"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#2D7D46"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Notification banner if any -->
            <Border Background="#ECFDF5" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6"
                    Padding="12,10" Margin="0,0,0,18"
                    Visibility="{Binding NotificationMessage, Converter={x:Null}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔔 " FontSize="14"/>
                    <TextBlock Text="{Binding NotificationMessage}" FontWeight="SemiBold" Foreground="#065F46" VerticalAlignment="Center"/>
                </StackPanel>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NotificationMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <!-- Metrics grid (4 cards) -->
            <UniformGrid Columns="4" Margin="0,0,0,24">
                <!-- Stat 1: Revenue -->
                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Total Revenue" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                            <Border HorizontalAlignment="Right" Background="{StaticResource PillGreenBg}" CornerRadius="10" Padding="8,2">
                                <TextBlock Text="+14.2%" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource PillGreenText}"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding TotalRevenue}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource ForestBrush}" Margin="0,8,0,2"/>
                        <TextBlock Text="vs $16,110.00 last week" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Stat 2: Active Orders -->
                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Active Orders" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                            <Border HorizontalAlignment="Right" Background="#EFF6FF" CornerRadius="10" Padding="8,2">
                                <TextBlock Text="Live" FontSize="10.5" FontWeight="Bold" Foreground="#1D4ED8"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding ActiveOrdersCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource ForestBrush}" Margin="0,8,0,2"/>
                        <TextBlock Text="6 awaiting pickup / delivery" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Stat 3: Low Stock Alerts -->
                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Low Stock Items" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                            <Border HorizontalAlignment="Right" Background="{StaticResource PillAmberBg}" CornerRadius="10" Padding="8,2">
                                <TextBlock Text="Attention" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource PillAmberText}"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding LowStockCount}" FontSize="24" FontWeight="Bold" Foreground="#B45309" Margin="0,8,0,2"/>
                        <TextBlock Text="Items with &lt; 10 units in stock" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Stat 4: Customers -->
                <Border Style="{StaticResource MetricCard}" Margin="0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Registered Customers" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                            <Border HorizontalAlignment="Right" Background="{StaticResource PillGreenBg}" CornerRadius="10" Padding="8,2">
                                <TextBlock Text="+12 Today" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource PillGreenText}"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding CustomerCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource ForestBrush}" Margin="0,8,0,2"/>
                        <TextBlock Text="Across local delivery areas" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Bottom content: Inventory (Left) and Orders (Right) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6.5*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="3.5*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Grocery Inventory Table -->
                <Border Grid.Column="0"
                        Background="{StaticResource CardBackground}"
                        BorderBrush="{StaticResource BorderBrushLight}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="Store Inventory &amp; Stock Levels"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource ForestBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock HorizontalAlignment="Right"
                                       Text="Showing 8 priority products"
                                       FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Items List -->
                        <ItemsControl ItemsSource="{Binding Inventory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrushLight}"
                                            BorderThickness="0,0,0,1"
                                            Padding="6,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Sku -->
                                            <TextBlock Grid.Column="0" Text="{Binding Sku}" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>

                                            <!-- Name & Category -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource InkBrush}"/>
                                                <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                            </StackPanel>

                                            <!-- Stock count -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StockQuantity, StringFormat='{}{0} in stock'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                                                <TextBlock Text="{Binding Unit, StringFormat='{}Unit: {0}'}" FontSize="10.5" Foreground="{StaticResource MutedBrush}"/>
                                            </StackPanel>

                                            <!-- Price -->
                                            <TextBlock Grid.Column="3" Text="{Binding FormattedPriceWithUnit}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource ForestBrush}" VerticalAlignment="Center"/>

                                            <!-- Tag / Status badge -->
                                            <Border Grid.Column="4" CornerRadius="10" Padding="6,2" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource PillGreenBg}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource PillAmberBg}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Tag}" FontSize="10.5" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource PillGreenText}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource PillAmberText}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <!-- Quick action -->
                                            <Button Grid.Column="5"
                                                    Content="+ Restock"
                                                    Style="{StaticResource SmallActionButton}"
                                                    Command="{Binding DataContext.RestockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Right: Recent Orders Feed -->
                <Border Grid.Column="2"
                        Background="{StaticResource CardBackground}"
                        BorderBrush="{StaticResource BorderBrushLight}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20">
                    <StackPanel>
                        <TextBlock Text="Recent Customer Orders"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource ForestBrush}"
                                   Margin="0,0,0,16"/>

                        <ItemsControl ItemsSource="{Binding RecentOrders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrushLight}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding OrderId}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource InkBrush}"/>
                                                <TextBlock Text="{Binding CustomerName}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,2"/>
                                                <TextBlock Text="{Binding PlacedAt}" FontSize="11" Foreground="#9CA3AF"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FormattedTotal}" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource ForestBrush}" HorizontalAlignment="Right"/>
                                                <Border Background="#F3F4F6" CornerRadius="8" Padding="6,2" Margin="0,4,0,0" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold" Foreground="#374151"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
