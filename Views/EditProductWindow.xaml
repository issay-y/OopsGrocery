<Window x:Class="OopsGrocery.Views.EditProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Inventory Item"
        Width="580"
        MaxHeight="850"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Inter, Segoe UI, Arial"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <SolidColorBrush x:Key="ForestBrush" Color="#1B4D2B"/>
        <SolidColorBrush x:Key="ForestHoverBrush" Color="#225933"/>
        <SolidColorBrush x:Key="YellowBrush" Color="#FFC926"/>
        <SolidColorBrush x:Key="YellowHoverBrush" Color="#F6BE14"/>
        <SolidColorBrush x:Key="InkBrush" Color="#1E293B"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderBrushLight" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="CardStrokeBrush" Color="#C5CDD8"/>
        <SolidColorBrush x:Key="PillBlueBg" Color="#EFF6FF"/>
        <SolidColorBrush x:Key="PillBlueText" Color="#1D4ED8"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="InputFrame" TargetType="Border">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,0"/>
        </Style>

        <Style x:Key="ReadOnlyFrame" TargetType="Border">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,0"/>
        </Style>

        <!-- Text shown inside a read-only frame -->
        <Style x:Key="ReadOnlyValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,0,28,0"/>
        </Style>

        <!-- Small lock icon on the right edge of a read-only frame -->
        <Style x:Key="LockGlyph" TargetType="TextBlock">
            <Setter Property="Text" Value="🔒"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.65"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="BareTextBox" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        </Style>

        <Style x:Key="CloseIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="18">
                            <TextBlock Text="✕" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryModalButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ForestBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ForestHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryModalButton" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Border Background="White" CornerRadius="14" BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#0F172A" Opacity="0.25" BlurRadius="20" ShadowDepth="5" Direction="270"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="26,24,20,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24" Background="{StaticResource PillBlueBg}" VerticalAlignment="Center">
                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{StaticResource PillBlueText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Text="Edit Inventory Item" FontSize="20" FontWeight="Bold" Foreground="{StaticResource ForestBrush}"/>
                        <TextBlock Text="Update the item's price and product image." FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource CloseIconButtonStyle}" Click="CloseButton_OnClick"/>
                </Grid>

                <Separator Grid.Row="0" VerticalAlignment="Bottom" Background="{StaticResource BorderBrushLight}"/>

                <!-- Body -->
                <StackPanel Grid.Row="1" Margin="26,20,26,20">
                    <!-- Item ID (Read-only) -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Item ID (Read-Only)"/>
                        <Border Style="{StaticResource ReadOnlyFrame}">
                            <Grid VerticalAlignment="Center">
                                <TextBlock x:Name="ItemIdDisplay" FontWeight="Bold" FontSize="14.5" Foreground="{StaticResource MutedBrush}"/>
                                <Border HorizontalAlignment="Right" Background="#F1F5F9" CornerRadius="4" Padding="8,3">
                                    <TextBlock Text="🔒 Fixed ID" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Item Name (Read-only) -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Item Name (Read-Only)"/>
                        <Border Style="{StaticResource ReadOnlyFrame}">
                            <Grid VerticalAlignment="Center">
                                <TextBlock x:Name="ItemNameDisplay" Style="{StaticResource ReadOnlyValue}"/>
                                <TextBlock Style="{StaticResource LockGlyph}"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Category (Read-only) -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Category (Read-Only)"/>
                        <Border Style="{StaticResource ReadOnlyFrame}">
                            <Grid VerticalAlignment="Center">
                                <TextBlock x:Name="CategoryDisplay" Style="{StaticResource ReadOnlyValue}"/>
                                <TextBlock Style="{StaticResource LockGlyph}"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Price (editable) & Unit (read-only) -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Price (₱) *"/>
                            <Border Style="{StaticResource InputFrame}">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="₱ " FontSize="15" FontWeight="Bold" Foreground="{StaticResource ForestBrush}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="PriceInput" Grid.Column="1" Style="{StaticResource BareTextBox}"
                                             MaxLength="12"
                                             PreviewTextInput="PriceInput_OnPreviewTextInput"
                                             PreviewKeyDown="NumericInput_OnPreviewKeyDown"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Unit (Read-Only)"/>
                            <Border Style="{StaticResource ReadOnlyFrame}">
                                <Grid VerticalAlignment="Center">
                                    <TextBlock x:Name="UnitDisplay" Style="{StaticResource ReadOnlyValue}"/>
                                    <TextBlock Style="{StaticResource LockGlyph}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Optional Product Image File with Live Preview -->
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Product Image (Optional)"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Live Thumbnail Preview Box -->
                            <Border Grid.Column="0"
                                    x:Name="ImagePreviewContainer"
                                    Width="72" Height="72"
                                    CornerRadius="10"
                                    Background="#EFF6FF"
                                    BorderBrush="{StaticResource BorderBrushLight}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center"
                                    Cursor="Hand"
                                    ToolTip="Click to browse for a product photo"
                                    MouseLeftButtonUp="PreviewContainer_OnMouseLeftButtonUp">
                                <TextBlock x:Name="ImagePreviewFallbackIcon"
                                           Text="📦"
                                           FontSize="32"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <!-- Path Input and Action Buttons -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource InputFrame}">
                                        <TextBox x:Name="ImagePathInput" Style="{StaticResource BareTextBox}"/>
                                    </Border>
                                    <Button Grid.Column="2" Content="Browse..." Width="90" Height="48" Style="{StaticResource SecondaryModalButton}" Click="BrowseImage_OnClick"/>
                                    <Button Grid.Column="4" Content="✕" Width="44" Height="48" Style="{StaticResource SecondaryModalButton}" ToolTip="Remove image" Click="ClearImage_OnClick"/>
                                </Grid>
                                <TextBlock Text="Select a PNG, JPG, or WEBP photo. Category illustration is used when left empty."
                                           FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="2,5,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!-- Footer -->
                <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="0,1,0,0" CornerRadius="0,0,13,13" Padding="26,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Cancel" Style="{StaticResource SecondaryModalButton}" Click="CancelButton_OnClick"/>
                        <Button Grid.Column="2" Content="Save Changes" IsDefault="True" Style="{StaticResource PrimaryModalButton}" Click="SaveButton_OnClick"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
