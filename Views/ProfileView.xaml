<UserControl x:Class="OopsGrocery.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <SolidColorBrush x:Key="ForestBrush" Color="#1B4D2B"/>
        <SolidColorBrush x:Key="ForestHoverBrush" Color="#225933"/>
        <SolidColorBrush x:Key="YellowBrush" Color="#FFC926"/>
        <SolidColorBrush x:Key="InkBrush" Color="#1E293B"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderBrushLight" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PillGreenBg" Color="#DCFCE7"/>
        <SolidColorBrush x:Key="PillGreenText" Color="#166534"/>
        <SolidColorBrush x:Key="PillPurpleBg" Color="#F3E8FF"/>
        <SolidColorBrush x:Key="PillPurpleText" Color="#6B21A8"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,32">
            <!-- Header section -->
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="👤 " FontSize="22"/>
                        <TextBlock Text="Administrator Profile"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource ForestBrush}"/>
                    </StackPanel>
                    <TextBlock Text="Account identity, access tier, security credentials, and active session details."
                               FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Notification banner -->
            <Border Background="#ECFDF5" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6"
                    Padding="12,10" Margin="0,0,0,18">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NotificationMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔔 " FontSize="14"/>
                    <TextBlock Text="{Binding NotificationMessage}" FontWeight="SemiBold" Foreground="#065F46" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 2-Column Layout -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="6*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Identity & Access Card -->
                <StackPanel Grid.Column="0">
                    <Border Background="{StaticResource CardBackground}"
                            BorderBrush="{StaticResource BorderBrushLight}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="24"
                            Margin="0,0,0,20">
                        <StackPanel HorizontalAlignment="Center">
                            <!-- Large Avatar -->
                            <Border Width="72" Height="72"
                                    Background="{StaticResource ForestBrush}"
                                    CornerRadius="36"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,14">
                                <TextBlock Text="{Binding Initial}"
                                           FontWeight="Bold" FontSize="32"
                                           Foreground="{StaticResource YellowBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="{Binding Username}"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource InkBrush}"
                                       HorizontalAlignment="Center"/>

                            <Border Background="{StaticResource PillPurpleBg}"
                                    CornerRadius="12" Padding="12,4"
                                    HorizontalAlignment="Center" Margin="0,6,0,16">
                                <TextBlock Text="{Binding RoleBadge}"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource PillPurpleText}"/>
                            </Border>

                            <Border Height="1" Background="{StaticResource BorderBrushLight}" Margin="0,4,0,16"/>

                            <!-- Details list -->
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Account ID" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="{Binding AccountId}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Branch Location" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="{Binding StoreBranch}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Account Status" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PillGreenText}" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Last Authenticated" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="{Binding FormattedLastLogin}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Permissions Card -->
                    <Border Background="{StaticResource CardBackground}"
                            BorderBrush="{StaticResource BorderBrushLight}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="Role Privileges &amp; Access" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource ForestBrush}" Margin="0,0,0,12"/>
                            <TextBlock Text="✓ Full Store Dashboard &amp; Analytics" FontSize="12" Foreground="{StaticResource InkBrush}" Margin="0,3"/>
                            <TextBlock Text="✓ Products, Pricing &amp; Inventory Restock" FontSize="12" Foreground="{StaticResource InkBrush}" Margin="0,3"/>
                            <TextBlock Text="✓ Sales Transaction Audit &amp; CSV Export" FontSize="12" Foreground="{StaticResource InkBrush}" Margin="0,3"/>
                            <TextBlock Text="✓ Staff User Provisioning &amp; Role Management" FontSize="12" Foreground="{StaticResource InkBrush}" Margin="0,3"/>
                            <TextBlock Text="✓ MariaDB Database Direct Connectivity" FontSize="12" Foreground="{StaticResource InkBrush}" Margin="0,3"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Column: Security & Credentials -->
                <Border Grid.Column="2"
                        Background="{StaticResource CardBackground}"
                        BorderBrush="{StaticResource BorderBrushLight}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="26">
                    <StackPanel>
                        <TextBlock Text="Security &amp; Password Preferences"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource ForestBrush}"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="Update your admin password using PBKDF2 encryption standard."
                                   FontSize="12" Foreground="{StaticResource MutedBrush}"
                                   Margin="0,0,0,20"/>

                        <!-- Current Password -->
                        <TextBlock Text="Current Password" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,0,0,6"/>
                        <PasswordBox Height="36"
                                     FontSize="13"
                                     Padding="8,6"
                                     BorderBrush="{StaticResource BorderBrushLight}"
                                     BorderThickness="1"
                                     Margin="0,0,0,16"/>

                        <!-- New Password -->
                        <TextBlock Text="New Password" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,0,0,6"/>
                        <PasswordBox Height="36"
                                     FontSize="13"
                                     Padding="8,6"
                                     BorderBrush="{StaticResource BorderBrushLight}"
                                     BorderThickness="1"
                                     Margin="0,0,0,16"/>

                        <!-- Confirm New Password -->
                        <TextBlock Text="Confirm New Password" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,0,0,6"/>
                        <PasswordBox Height="36"
                                     FontSize="13"
                                     Padding="8,6"
                                     BorderBrush="{StaticResource BorderBrushLight}"
                                     BorderThickness="1"
                                     Margin="0,0,0,22"/>

                        <!-- Save button -->
                        <Button Content="Update Password Credentials"
                                Command="{Binding SaveChangesCommand}"
                                Background="{StaticResource ForestBrush}"
                                Foreground="White"
                                FontWeight="SemiBold"
                                FontSize="13"
                                Height="38"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="{StaticResource ForestHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
