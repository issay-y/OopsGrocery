<Window x:Class="OopsGrocery.Views.AddUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Provision New Cashier Account"
        Width="860"
        MaxHeight="1000"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Inter, Segoe UI, Arial"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <SolidColorBrush x:Key="ForestBrush" Color="#1B4D2B"/>
        <SolidColorBrush x:Key="ForestHoverBrush" Color="#225933"/>
        <SolidColorBrush x:Key="YellowBrush" Color="#FFC926"/>
        <SolidColorBrush x:Key="YellowHoverBrush" Color="#F6BE14"/>
        <SolidColorBrush x:Key="YellowPressedBrush" Color="#E5B00E"/>
        <SolidColorBrush x:Key="InkBrush" Color="#1E293B"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderBrushLight" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="CardStrokeBrush" Color="#C5CDD8"/>
        <SolidColorBrush x:Key="PlaceholderBrush" Color="#94A3B8"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="InputBorderHoverBrush" Color="#94A3B8"/>
        <SolidColorBrush x:Key="HoverTintBrush" Color="#141B4D2B"/>
        <SolidColorBrush x:Key="PillGreenBg" Color="#DCFCE7"/>
        <SolidColorBrush x:Key="PillGreenText" Color="#166534"/>

        <!-- Field Label -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Helper / hint text under fields -->
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Placeholder hint -->
        <Style x:Key="PlaceholderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PlaceholderBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <!-- Rounded Input Frame -->
        <Style x:Key="InputFrame" TargetType="Border">
            <Setter Property="Height" Value="66"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource InputBorderHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource ForestBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="Padding" Value="15,0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BareTextBox" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource ForestBrush}"/>
        </Style>

        <Style x:Key="BarePasswordBox" TargetType="PasswordBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource ForestBrush}"/>
        </Style>

        <!-- Eye toggle button -->
        <Style x:Key="EyeToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Show password"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="8">
                            <Viewbox Width="23" Height="23">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M2,12 C6,5.5 18,5.5 22,12 C18,18.5 6,18.5 2,12 Z"
                                          Stroke="{StaticResource ForestBrush}" StrokeThickness="1.8"
                                          StrokeLineJoin="Round"/>
                                    <Ellipse Canvas.Left="9" Canvas.Top="9" Width="6" Height="6"
                                             Stroke="{StaticResource ForestBrush}" StrokeThickness="1.8"/>
                                    <Line x:Name="Slash" X1="4" Y1="4" X2="20" Y2="20"
                                          Stroke="{StaticResource ForestBrush}" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Visibility="Collapsed"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverTintBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Slash" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="ToolTip" Value="Hide password"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Primary Action Button -->
        <Style x:Key="PrimaryModalButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource YellowBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ForestBrush}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="66"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource YellowHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource YellowPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Modal Button -->
        <Style x:Key="SecondaryModalButton" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="66"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close "X" Button -->
        <Style x:Key="CloseIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="20">
                            <TextBlock Text="✕" FontSize="16" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer shadow container -->
    <Grid Margin="22">
        <Border Background="White"
                CornerRadius="16"
                BorderBrush="{StaticResource CardStrokeBrush}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#0F172A"
                                  Opacity="0.30"
                                  BlurRadius="22"
                                  ShadowDepth="6"
                                  Direction="270"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header: Icon Badge, Title, and Close Button -->
                <Grid Grid.Row="0" Margin="34,40,26,34">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon Badge -->
                    <Border Grid.Column="0"
                            Width="60" Height="60"
                            CornerRadius="30"
                            Background="{StaticResource PillGreenBg}"
                            VerticalAlignment="Center">
                        <Viewbox Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="M15,19 C15,16.5 12,15 8,15 C4,15 1,16.5 1,19"
                                      Stroke="{StaticResource PillGreenText}" StrokeThickness="1.8" StrokeStartLineCap="Round"/>
                                <Ellipse Canvas.Left="4" Canvas.Top="3" Width="8" Height="8"
                                         Stroke="{StaticResource PillGreenText}" StrokeThickness="1.8"/>
                                <Line X1="19" Y1="8" X2="19" Y2="14"
                                      Stroke="{StaticResource PillGreenText}" StrokeThickness="2" StrokeStartLineCap="Round"/>
                                <Line X1="16" Y1="11" X2="22" Y2="11"
                                      Stroke="{StaticResource PillGreenText}" StrokeThickness="2" StrokeStartLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Border>

                    <!-- Title & Subtitle -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0">
                        <TextBlock Text="Provision New Cashier Account"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource ForestBrush}"/>
                        <TextBlock Text="Register a new cashier user for POS sales, inventory lookup, and shift checkout."
                                   FontSize="14.5"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Close 'X' Button -->
                    <Button Grid.Column="2"
                            VerticalAlignment="Center"
                            Style="{StaticResource CloseIconButtonStyle}"
                            Click="CloseIconButton_OnClick"/>
                </Grid>

                <Separator Grid.Row="0" VerticalAlignment="Bottom" Margin="0" Background="{StaticResource BorderBrushLight}"/>

                <!-- Body: Input Fields with Responsive Two-Column Layout -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="34,40,34,40">

                        <!-- Row 1: Full Name (Full Width for clarity) -->
                        <StackPanel Margin="0,0,0,36">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Staff Full Name *"/>
                            <Border Style="{StaticResource InputFrame}">
                                <Grid>
                                    <TextBox x:Name="FullNameTextBox"
                                             Style="{StaticResource BareTextBox}"
                                             PreviewTextInput="FullNameTextBox_OnPreviewTextInput"
                                             TextChanged="FullNameTextBox_OnTextChanged"/>
                                    <TextBlock x:Name="FullNamePlaceholder"
                                               Style="{StaticResource PlaceholderText}"
                                               Text="First Name, Middle Initial, Last Name."/>
                                </Grid>
                            </Border>
                            <TextBlock Text="Format: First Name, Middle Initial, Last Name (letters, spaces, periods, and hyphens only)."
                                       Style="{StaticResource HintText}" Margin="2,10,0,0"/>
                        </StackPanel>

                        <!-- Row 2: Username & Role (Side by Side) -->
                        <Grid Margin="0,0,0,36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Column 0: Username -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Username (Login ID) *"/>
                                <Border Style="{StaticResource InputFrame}">
                                    <Grid>
                                        <TextBox x:Name="UsernameTextBox"
                                                 Style="{StaticResource BareTextBox}"
                                                 TextChanged="UsernameTextBox_OnTextChanged"/>
                                        <TextBlock x:Name="UsernamePlaceholder"
                                                   Style="{StaticResource PlaceholderText}"
                                                   Text="e.g. maria_cashier"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="Strictly case-sensitive and must be unique."
                                           Style="{StaticResource HintText}" Margin="2,10,0,0"/>
                            </StackPanel>

                            <!-- Column 1: System Role (Locked) -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Assigned Role *"/>
                                <Border Background="#F8FAFC"
                                        BorderBrush="{StaticResource BorderBrushLight}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Height="66"
                                        Padding="16,0">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Background="{StaticResource PillGreenBg}"
                                                CornerRadius="7"
                                                Padding="10,4"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="🛒 CASHIER"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource PillGreenText}"/>
                                        </Border>
                                        <TextBlock Grid.Column="1"
                                                   Text="POS Terminal"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource InkBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="🔒 Store policy: strictly 1 Admin enforced."
                                           Style="{StaticResource HintText}" Margin="2,10,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 3: Password & Confirm Password (Side by Side) -->
                        <Grid Margin="0,0,0,40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Password -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Password *"/>
                                <Border Style="{StaticResource InputFrame}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <PasswordBox x:Name="PasswordInput"
                                                     Grid.Column="0"
                                                     Style="{StaticResource BarePasswordBox}"
                                                     PasswordChanged="PasswordInput_OnPasswordChanged"/>
                                        <TextBox x:Name="RevealedPasswordTextBox"
                                                 Grid.Column="0"
                                                 Visibility="Collapsed"
                                                 Style="{StaticResource BareTextBox}"
                                                 TextChanged="RevealedPasswordTextBox_OnTextChanged"/>

                                        <TextBlock x:Name="PasswordPlaceholder"
                                                   Grid.Column="0"
                                                   Style="{StaticResource PlaceholderText}"
                                                   Text="8–10 characters"/>

                                        <ToggleButton x:Name="ShowPasswordToggle"
                                                      Grid.Column="1"
                                                      Style="{StaticResource EyeToggleStyle}"
                                                      Click="ShowPasswordToggle_OnClick"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Confirm Password -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Confirm Password *"/>
                                <Border Style="{StaticResource InputFrame}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <PasswordBox x:Name="ConfirmPasswordInput"
                                                     Grid.Column="0"
                                                     Style="{StaticResource BarePasswordBox}"
                                                     PasswordChanged="ConfirmPasswordInput_OnPasswordChanged"/>
                                        <TextBox x:Name="RevealedConfirmPasswordTextBox"
                                                 Grid.Column="0"
                                                 Visibility="Collapsed"
                                                 Style="{StaticResource BareTextBox}"
                                                 TextChanged="RevealedConfirmPasswordTextBox_OnTextChanged"/>

                                        <TextBlock x:Name="ConfirmPasswordPlaceholder"
                                                   Grid.Column="0"
                                                   Style="{StaticResource PlaceholderText}"
                                                   Text="Re-enter password"/>

                                        <ToggleButton x:Name="ShowConfirmPasswordToggle"
                                                      Grid.Column="1"
                                                      Style="{StaticResource EyeToggleStyle}"
                                                      Click="ShowConfirmPasswordToggle_OnClick"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Password Security Policy Info Card -->
                        <Border Background="#F8FAFC"
                                BorderBrush="{StaticResource BorderBrushLight}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="24,24">
                            <StackPanel>
                                <TextBlock Text="🛡️  Password Requirements &amp; Security Rules"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource ForestBrush}"/>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="• Length: strictly 8 to 10 characters" FontSize="14" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock Text="• At least 1 uppercase (A–Z)" FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0"/>
                                        <TextBlock Text="• At least 1 numeric digit (0–9)" FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="• At least 1 allowed symbol: . , _ or -" FontSize="14" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock Text="• Cannot match the username" FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0"/>
                                        <TextBlock Text="• No repeating or sequential patterns (123, aaa)" FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- Footer: Cancel and Create Account Buttons (Pinned) -->
                <Border Grid.Row="2"
                        Background="#F8FAFC"
                        BorderBrush="{StaticResource BorderBrushLight}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,15,15"
                        Padding="34,30">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Cancel"
                                Style="{StaticResource SecondaryModalButton}"
                                Click="CancelButton_OnClick"/>

                        <Button Grid.Column="2"
                                Content="Create Account"
                                Width="250"
                                IsDefault="True"
                                Style="{StaticResource PrimaryModalButton}"
                                Click="CreateAccountButton_OnClick"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
