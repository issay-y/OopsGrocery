<Window x:Class="OopsGrocery.Views.ExportCompleteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Report Exported Successfully"
        Width="540"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Inter, Segoe UI, Arial"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Brand Palette -->
        <SolidColorBrush x:Key="ForestBrush" Color="#1B4D2B"/>
        <SolidColorBrush x:Key="ForestHoverBrush" Color="#225933"/>
        <SolidColorBrush x:Key="YellowBrush" Color="#FFC926"/>
        <SolidColorBrush x:Key="YellowHoverBrush" Color="#F6BE14"/>
        <SolidColorBrush x:Key="YellowPressedBrush" Color="#E5B00E"/>
        <SolidColorBrush x:Key="InkBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderBrushLight" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="CardStrokeBrush" Color="#CBD5E1"/>

        <!-- Primary Action Button (Forest / White) -->
        <Style x:Key="PrimaryActionModalButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ForestBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ForestHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#143A20"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Action Button -->
        <Style x:Key="SecondaryActionModalButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Subtle Close 'X' Button -->
        <Style x:Key="ModalCloseIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="14">
                            <TextBlock Text="✕" FontSize="12" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer margin for soft drop shadow -->
    <Grid Margin="32">
        <Border Background="White"
                CornerRadius="14"
                BorderBrush="{StaticResource CardStrokeBrush}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#0F172A"
                                  Opacity="0.32"
                                  BlurRadius="28"
                                  ShadowDepth="8"
                                  Direction="270"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ================= HEADER SECTION ================= -->
                <Grid Grid.Row="0" Margin="24,22,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Green Success Badge -->
                    <Border Grid.Column="0"
                            Width="42" Height="42"
                            CornerRadius="21"
                            Background="#DCFCE7"
                            VerticalAlignment="Center">
                        <Viewbox Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Ellipse Canvas.Left="2" Canvas.Top="2" Width="20" Height="20"
                                         Fill="#16A34A"/>
                                <Path Data="M7,12.5 L10.5,16 L17,9"
                                      Stroke="White" StrokeThickness="2.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Border>

                    <!-- Header Titles -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Text="Report Exported Successfully"
                                   FontSize="16.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource ForestBrush}"/>
                        <TextBlock Text="Sales analytics and itemized ledger compiled to CSV"
                                   FontSize="11.5"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Close Button -->
                    <Button Grid.Column="2"
                            VerticalAlignment="Center"
                            Margin="0,0,-4,0"
                            Style="{StaticResource ModalCloseIconButtonStyle}"
                            Click="CloseButton_OnClick"/>
                </Grid>

                <!-- ================= BODY / FILE DETAILS ================= -->
                <StackPanel Grid.Row="1" Margin="24,18,24,20">
                    <TextBlock Text="Your export is ready and saved locally. You can open the spreadsheet directly, view its folder location, or copy the file path below."
                               FontSize="12.5"
                               LineHeight="18"
                               Foreground="{StaticResource InkBrush}"
                               TextWrapping="Wrap"/>

                    <!-- File Details Card -->
                    <Border Background="#F8FAFC"
                            BorderBrush="{StaticResource BorderBrushLight}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16,14"
                            Margin="0,14,0,0">
                        <StackPanel>
                            <!-- File Name & Extension Badge -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="📊 " FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                <TextBlock x:Name="FileNameText"
                                           Grid.Column="1"
                                           Text="OopsGrocery_SalesReport_Today_20261025.csv"
                                           FontWeight="Bold"
                                           FontSize="13.5"
                                           Foreground="{StaticResource InkBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>

                                <Border Grid.Column="2"
                                        Background="#DCFCE7"
                                        CornerRadius="6"
                                        Padding="8,2"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="CSV FILE"
                                               FontSize="10.5"
                                               FontWeight="Bold"
                                               Foreground="#166534"/>
                                </Border>
                            </Grid>

                            <!-- Destination Path with Copy Button -->
                            <Border Background="#FFFFFF"
                                    BorderBrush="{StaticResource BorderBrushLight}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,6"
                                    Margin="0,10,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="FilePathText"
                                               Grid.Column="0"
                                               Text="C:\Users\Allyssa\Desktop\OopsGrocery_SalesReport.csv"
                                               FontSize="11.5"
                                               Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               FontFamily="Consolas, Segoe UI Mono, monospace"/>

                                    <Button x:Name="CopyPathButton"
                                            Grid.Column="1"
                                            Content="📋 Copy"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource ForestBrush}"
                                            Background="#F1F5F9"
                                            BorderThickness="0"
                                            Padding="8,3"
                                            Cursor="Hand"
                                            Click="CopyPathButton_OnClick">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Metadata Badges Row -->
                            <WrapPanel Orientation="Horizontal">
                                <!-- Period -->
                                <Border Background="#EFF6FF" CornerRadius="6" Padding="8,4" Margin="0,0,8,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📅 Period: " FontSize="11" Foreground="#1D4ED8" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="PeriodText" Text="Today" FontSize="11" Foreground="#1E40AF" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <!-- File Size -->
                                <Border Background="#FEF3C7" CornerRadius="6" Padding="8,4" Margin="0,0,8,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💾 Size: " FontSize="11" Foreground="#B45309" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="FileSizeText" Text="2.4 KB" FontSize="11" Foreground="#92400E" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <!-- Timestamp -->
                                <Border Background="#F1F5F9" CornerRadius="6" Padding="8,4" Margin="0,0,8,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🕒 Generated: " FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock x:Name="TimestampText" Text="5:00 PM" FontSize="11" Foreground="{StaticResource InkBrush}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>

                                <!-- Encoding -->
                                <Border Background="#ECFDF5" CornerRadius="6" Padding="8,4" Margin="0,0,0,4">
                                    <TextBlock Text="✓ UTF-8 Monitored" FontSize="11" Foreground="#047857" FontWeight="SemiBold"/>
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ================= FOOTER / ACTION BUTTONS ================= -->
                <Border Grid.Row="2"
                        Background="#F8FAFC"
                        BorderBrush="{StaticResource BorderBrushLight}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,13,13"
                        Padding="20,14">
                    <Grid>
                        <!-- Done / Dismiss Button -->
                        <Button Content="Done"
                                Width="80"
                                HorizontalAlignment="Left"
                                Style="{StaticResource SecondaryActionModalButton}"
                                Click="CloseButton_OnClick"/>

                        <!-- Right Action Buttons: Open Folder + Open CSV -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="📂 View in Folder"
                                    Style="{StaticResource SecondaryActionModalButton}"
                                    Margin="0,0,10,0"
                                    Click="OpenFolderButton_OnClick"/>

                            <Button Content="📊 Open CSV File"
                                    Style="{StaticResource PrimaryActionModalButton}"
                                    Click="OpenFileButton_OnClick"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
