<Window x:Class="OopsGrocery.Views.ViewProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Staff Profile"
        Width="720"
        MaxHeight="860"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Inter, Segoe UI, Arial"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Brand Colors -->
        <SolidColorBrush x:Key="ForestBrush" Color="#1B4D2B"/>
        <SolidColorBrush x:Key="ForestHoverBrush" Color="#225933"/>
        <SolidColorBrush x:Key="YellowBrush" Color="#FFC926"/>
        <SolidColorBrush x:Key="InkBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderBrushLight" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>

        <!-- Pill Badges -->
        <SolidColorBrush x:Key="PillPurpleBg" Color="#F5F3FF"/>
        <SolidColorBrush x:Key="PillPurpleText" Color="#7C3AED"/>
        <SolidColorBrush x:Key="PillGreenBg" Color="#DCFCE7"/>
        <SolidColorBrush x:Key="PillGreenText" Color="#166534"/>
        <SolidColorBrush x:Key="PillBlueBg" Color="#EFF6FF"/>
        <SolidColorBrush x:Key="PillBlueText" Color="#1D4ED8"/>

        <!-- Close Icon Button Style -->
        <Style x:Key="CloseIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="19">
                            <TextBlock Text="✕" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button -->
        <Style x:Key="PrimaryModalButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ForestBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ForestHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="White"
            CornerRadius="16"
            BorderThickness="1"
            BorderBrush="#CBD5E1"
            Margin="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30"
                              Direction="270"
                              Opacity="0.20"
                              ShadowDepth="5"
                              Color="#0F172A"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Titlebar -->
                <RowDefinition Height="*"/>    <!-- Content -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- ================= HEADER ================= -->
            <Border Grid.Row="0"
                    Background="#F8FAFC"
                    CornerRadius="16,16,0,0"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{StaticResource BorderBrushLight}"
                    Padding="28,20"
                    MouseLeftButtonDown="Header_OnMouseLeftButtonDown"
                    Cursor="SizeAll">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="👤 " FontSize="22"/>
                            <TextBlock Text="Staff Profile"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource ForestBrush}"/>
                        </StackPanel>
                        <TextBlock Text="Read-only staff account information and operational scope."
                                   FontSize="13.5" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource CloseIconButtonStyle}"
                            Click="CloseButton_Click"
                            ToolTip="Close dialog (Esc)"/>
                </Grid>
            </Border>

            <!-- ================= BODY CONTENT ================= -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,24,28,20">

                    <!-- MAIN USER PROFILE CARD (VIEW ONLY) -->
                    <Border Background="#F8FAFC"
                            BorderBrush="{StaticResource BorderBrushLight}"
                            BorderThickness="1"
                            CornerRadius="14">
                        <Grid>
                            <!-- Top accent stripe: purple for admin, forest green for cashier -->
                            <Border Height="5"
                                    VerticalAlignment="Top"
                                    CornerRadius="14,14,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource ForestBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                                <Setter Property="Background" Value="#7C3AED"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <StackPanel Margin="24,24,24,22">
                                <!-- Top Avatar + Name Row -->
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Large Avatar Circle -->
                                    <Border Grid.Column="0"
                                            Width="80" Height="80"
                                            Background="{StaticResource YellowBrush}"
                                            CornerRadius="40"
                                            Margin="0,0,20,0">
                                        <TextBlock Text="{Binding Initial}"
                                                   FontWeight="Bold" FontSize="36"
                                                   Foreground="{StaticResource ForestBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Name & Role Pills -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="24" FontWeight="Bold"
                                                   Foreground="{StaticResource InkBrush}"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <!-- Role Badge Pill -->
                                            <Border CornerRadius="8" Padding="12,5" Margin="0,0,10,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource PillGreenBg}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource PillPurpleBg}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding RoleBadge}" FontSize="12.5" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource PillGreenText}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource PillPurpleText}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <!-- Active Status Pill -->
                                            <Border Background="{StaticResource PillGreenBg}" CornerRadius="8" Padding="12,5">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="8" Height="8" Fill="#16A34A" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding AccountStatus}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource PillGreenText}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="{StaticResource BorderBrushLight}" Margin="0,0,0,20"/>

                                <!-- Profile Metadata Grid (Read-Only) -->
                                <UniformGrid Columns="2" Rows="2">
                                    <!-- Account ID Card -->
                                    <Border Background="White"
                                            BorderBrush="{StaticResource BorderBrushLight}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="16,14"
                                            Margin="0,0,8,12">
                                        <StackPanel>
                                            <TextBlock Text="ACCOUNT ID" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                                            <TextBlock Text="{Binding FormattedUserId}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource InkBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Username Card -->
                                    <Border Background="White"
                                            BorderBrush="{StaticResource BorderBrushLight}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="16,14"
                                            Margin="8,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="LOGIN USERNAME" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                                            <TextBlock Text="{Binding CurrentUser.Username}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource InkBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Store Location Card -->
                                    <Border Background="White"
                                            BorderBrush="{StaticResource BorderBrushLight}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="16,14"
                                            Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="STORE LOCATION" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                                            <TextBlock Text="Oops Grocery · Branch #01" FontSize="16" FontWeight="Bold" Foreground="{StaticResource InkBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Last Login Card -->
                                    <Border Background="White"
                                            BorderBrush="{StaticResource BorderBrushLight}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="16,14"
                                            Margin="8,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="LAST AUTHENTICATED" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                                            <TextBlock Text="{Binding FormattedLastLogin}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource InkBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- Operational Scope Box -->
                                <Border Background="White"
                                        BorderBrush="{StaticResource BorderBrushLight}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="16,14"
                                        Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="OPERATIONAL SCOPE &amp; ROLE" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding RoleDescription}"
                                                   FontSize="14" Foreground="{StaticResource InkBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Lock / Read-Only Banner -->
                                <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,16,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🔒" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="View-Only Profile — Staff account details and assigned roles are managed in User Management."
                                                   FontSize="13" FontWeight="SemiBold" Foreground="#92400E"
                                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= FOOTER ================= -->
            <Border Grid.Row="2"
                    Background="#F8FAFC"
                    CornerRadius="0,0,16,16"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{StaticResource BorderBrushLight}"
                    Padding="28,16">
                <Button Content="Close"
                        IsCancel="True"
                        Click="CloseButton_Click"
                        Style="{StaticResource PrimaryModalButton}"
                        HorizontalAlignment="Right"
                        Width="140"/>
            </Border>
        </Grid>
    </Border>
</Window>
