<Window x:Class="OopsGrocery.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Oops Grocery - Login"
        Width="1000"
        Height="650"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White"
        FontFamily="Inter, Segoe UI, Arial"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FocusManager.FocusedElement="{Binding ElementName=UsernameTextBox}">

    <Window.Resources>
        <!-- ===== Palette ===== -->
        <SolidColorBrush x:Key="ForestBrush" Color="#1B4D2B"/>
        <SolidColorBrush x:Key="CreamBrush" Color="#F5E6C8"/>
        <SolidColorBrush x:Key="YellowBrush" Color="#FFC926"/>
        <SolidColorBrush x:Key="YellowHoverBrush" Color="#F6BE14"/>
        <SolidColorBrush x:Key="YellowPressedBrush" Color="#E5B00E"/>
        <SolidColorBrush x:Key="BannerBrush" Color="#F8EFDB"/>
        <SolidColorBrush x:Key="InkBrush" Color="#222222"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#6B6B6B"/>
        <SolidColorBrush x:Key="IconBrush" Color="#7A7A7A"/>
        <SolidColorBrush x:Key="PlaceholderBrush" Color="#8A8A8A"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#D6D6D6"/>
        <SolidColorBrush x:Key="InputBorderHoverBrush" Color="#9C9C9C"/>
        <SolidColorBrush x:Key="HoverTintBrush" Color="#141B4D2B"/>

        <LinearGradientBrush x:Key="PanelGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#225C35" Offset="0"/>
            <GradientStop Color="#173F24" Offset="1"/>
        </LinearGradientBrush>

        <!-- Lora if installed, otherwise the fallbacks -->
        <FontFamily x:Key="SerifFont">Lora, Georgia, Times New Roman</FontFamily>

        <!-- ===== Text styles ===== -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Placeholder hint drawn over an input; clicks pass through to the box underneath -->
        <Style x:Key="PlaceholderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PlaceholderBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <!-- Shared outline icon stroke -->
        <Style x:Key="IconShape" TargetType="Shape">
            <Setter Property="Stroke" Value="{StaticResource IconBrush}"/>
            <Setter Property="StrokeThickness" Value="1.8"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
        </Style>

        <!-- ===== Inputs ===== -->
        <!-- Rounded frame: 1px grey, darker on hover, 2px green while focused -->
        <Style x:Key="InputFrame" TargetType="Border">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource InputBorderHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource ForestBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="Padding" Value="11,0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BareTextBox" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource ForestBrush}"/>
        </Style>

        <Style x:Key="BarePasswordBox" TargetType="PasswordBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource ForestBrush}"/>
        </Style>

        <!-- Eye toggle (a slash appears while the password is visible) -->
        <Style x:Key="EyeToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Show password"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M2,12 C6,5.5 18,5.5 22,12 C18,18.5 6,18.5 2,12 Z"
                                          Stroke="{StaticResource ForestBrush}" StrokeThickness="1.8"
                                          StrokeLineJoin="Round"/>
                                    <Ellipse Canvas.Left="9" Canvas.Top="9" Width="6" Height="6"
                                             Stroke="{StaticResource ForestBrush}" StrokeThickness="1.8"/>
                                    <Line x:Name="Slash" X1="4" Y1="4" X2="20" Y2="20"
                                          Stroke="{StaticResource ForestBrush}" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Visibility="Collapsed"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverTintBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Slash" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="ToolTip" Value="Hide password"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===== Primary button (dims when LoginCommand can't execute) ===== -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource YellowBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ForestBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect Color="#FFC926" Opacity="0.35"
                                                  BlurRadius="14" ShadowDepth="3" Direction="270"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ForestBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource YellowHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource YellowPressedBrush}"/>
                                <Setter TargetName="Chrome" Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource YellowBrush}"/>
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.55"/>
                                <Setter TargetName="Chrome" Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Left: brand panel ============ -->
        <Grid Grid.Column="0" Background="{StaticResource PanelGradientBrush}" ClipToBounds="True">

            <!-- Quiet background circles for depth -->
            <Ellipse Width="440" Height="440" Fill="#0AFFFFFF" IsHitTestVisible="False"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-190,-150"/>
            <Ellipse Width="260" Height="260" Fill="#0DFFC926" IsHitTestVisible="False"
                     HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-110,0,0,90"/>

            <Grid Margin="40,44,40,36">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <!-- Basket icon in a soft badge (uniform scaling, no distortion) -->
                    <Border Width="68" Height="68" CornerRadius="18" HorizontalAlignment="Left"
                            Background="#1FFFC926">
                        <Viewbox Width="40" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="34" Height="30">
                                <Path Stroke="{StaticResource YellowBrush}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M9,13 A8,11.5 0 0 1 25,13
                                            M1.5,13 L32.5,13
                                            M4,13 L7.5,28 L26.5,28 L30,13
                                            M5.5,20.5 L28.5,20.5
                                            M12.5,13 L12.5,28 M17,13 L17,28 M21.5,13 L21.5,28"/>
                            </Canvas>
                        </Viewbox>
                    </Border>

                    <TextBlock Margin="0,28,0,0"
                               FontFamily="{StaticResource SerifFont}" FontSize="33"
                               Foreground="{StaticResource CreamBrush}"><Run Text="OOPs OOPs OOPs "/><LineBreak/><Run Text="Grocery"/></TextBlock>

                    <Border Margin="0,18,0,0" Width="44" Height="3" CornerRadius="1.5"
                            HorizontalAlignment="Left" Background="{StaticResource YellowBrush}"/>

                    <TextBlock Margin="0,18,0,0" FontSize="18"
                               LineHeight="27" LineStackingStrategy="BlockLineHeight"
                               Foreground="{StaticResource CreamBrush}">
                        <Run>Good groceries.</Run><LineBreak/><Run Foreground="{StaticResource YellowBrush}">Better days.</Run>
                    </TextBlock>
                </StackPanel>

                <TextBlock Grid.Row="2" FontSize="12.5"
                           LineHeight="19" LineStackingStrategy="BlockLineHeight"
                           Foreground="{StaticResource CreamBrush}" Opacity="0.85">
                    Your neighborhood store,<LineBreak/>all in one dependable workspace.
                </TextBlock>
            </Grid>
        </Grid>

        <!-- ============ Right: sign-in panel ============ -->
        <Grid Grid.Column="1" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Width="400"
                        HorizontalAlignment="Center" VerticalAlignment="Top"
                        Margin="0,84,0,0">

                <TextBlock Text="Welcome back"
                           FontFamily="{StaticResource SerifFont}" FontSize="34" FontWeight="Bold"
                           Foreground="{StaticResource ForestBrush}"/>
                <TextBlock Margin="0,6,0,30"
                           Text="Sign in with your store account to begin your shift."
                           FontSize="13" Foreground="{StaticResource MutedBrush}"/>

                <!-- Username -->
                <TextBlock Style="{StaticResource FieldLabel}" Text="Username"/>
                <Border Style="{StaticResource InputFrame}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Viewbox Width="18" Height="18" Margin="0,0,10,0">
                            <Canvas Width="24" Height="24">
                                <Path Style="{StaticResource IconShape}"
                                      Data="M20,21 L20,19 A4,4 0 0 0 16,15 L8,15 A4,4 0 0 0 4,19 L4,21"/>
                                <Ellipse Style="{StaticResource IconShape}"
                                         Canvas.Left="8" Canvas.Top="3" Width="8" Height="8"/>
                            </Canvas>
                        </Viewbox>

                        <TextBox x:Name="UsernameTextBox" Grid.Column="1" TabIndex="0"
                                 Style="{StaticResource BareTextBox}"
                                 AutomationProperties.Name="Username"
                                 KeyDown="UsernameTextBox_OnKeyDown"
                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Column="1" Text="Enter your username">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource PlaceholderText}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=UsernameTextBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Password -->
                <TextBlock Style="{StaticResource FieldLabel}" Text="Password" Margin="0,20,0,6"/>
                <Border Style="{StaticResource InputFrame}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Viewbox Width="18" Height="18" Margin="0,0,10,0">
                            <Canvas Width="24" Height="24">
                                <Rectangle Style="{StaticResource IconShape}"
                                           Canvas.Left="3" Canvas.Top="11" Width="18" Height="11"
                                           RadiusX="2" RadiusY="2"/>
                                <Path Style="{StaticResource IconShape}"
                                      Data="M7,11 L7,7 A5,5 0 0 1 17,7 L17,11"/>
                            </Canvas>
                        </Viewbox>

                        <PasswordBox x:Name="PasswordInput" Grid.Column="1" TabIndex="1"
                                     Style="{StaticResource BarePasswordBox}"
                                     AutomationProperties.Name="Password"
                                     KeyDown="PasswordInput_OnKeyDown"
                                     PasswordChanged="PasswordBox_OnPasswordChanged"/>
                        <TextBox x:Name="RevealedPasswordTextBox" Grid.Column="1" TabIndex="1"
                                 Visibility="Collapsed"
                                 Style="{StaticResource BareTextBox}"
                                 AutomationProperties.Name="Password"
                                 KeyDown="RevealedPasswordTextBox_OnKeyDown"
                                 TextChanged="RevealedPasswordTextBox_OnTextChanged"/>

                        <!-- Hidden from PasswordBox_OnPasswordChanged once something is typed -->
                        <TextBlock x:Name="PasswordPlaceholder" Grid.Column="1"
                                   Style="{StaticResource PlaceholderText}"
                                   Text="Enter your password"/>

                        <ToggleButton x:Name="ShowPasswordToggle" Grid.Column="2" Margin="6,0,-6,0"
                                      Style="{StaticResource EyeToggleStyle}"
                                      AutomationProperties.Name="Show password"
                                      Click="ShowPasswordToggle_OnClick"/>
                    </Grid>
                </Border>

                <!-- Info banner -->
                <Border Margin="0,20,0,0" Padding="0,13,16,13"
                        Background="{StaticResource BannerBrush}"
                        BorderBrush="{StaticResource ForestBrush}"
                        BorderThickness="4,0,0,0"
                        CornerRadius="2,8,8,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Viewbox Width="20" Height="20" Margin="0,1,0,0"
                                 HorizontalAlignment="Center" VerticalAlignment="Top">
                            <Canvas Width="24" Height="24">
                                <Ellipse Canvas.Left="2" Canvas.Top="2" Width="20" Height="20"
                                         Stroke="{StaticResource ForestBrush}" StrokeThickness="1.6"/>
                                <Path Data="M12,11 L12,16.5"
                                      Stroke="{StaticResource ForestBrush}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Ellipse Canvas.Left="11" Canvas.Top="7" Width="2" Height="2"
                                         Fill="{StaticResource ForestBrush}"/>
                            </Canvas>
                        </Viewbox>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Role-based workspace" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource ForestBrush}"/>
                            <TextBlock Margin="0,2,0,0"
                                       Text="Your account role determines the tools you can access."
                                       FontSize="12.5" TextWrapping="Wrap"
                                       Foreground="{StaticResource InkBrush}" Opacity="0.85"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Login button -->
                <Button Margin="0,18,0,0" Height="46" IsDefault="True" TabIndex="2"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoginCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                            <Canvas Width="24" Height="24">
                                <Path Data="M15,3 L19,3 L21,5 L21,19 L19,21 L15,21"
                                      Stroke="{StaticResource ForestBrush}" StrokeThickness="2.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                <Path Data="M10,17 L15,12 L10,7 M15,12 L3,12"
                                      Stroke="{StaticResource ForestBrush}" StrokeThickness="2.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Login" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock Grid.Row="1" Margin="0,0,0,28"
                       Text="Need access? Contact your store administrator."
                       FontSize="12" TextAlignment="Center" HorizontalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}"/>
        </Grid>
    </Grid>
</Window>
