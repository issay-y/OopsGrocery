<UserControl x:Class="OopsGrocery.Views.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000"
             FontFamily="Inter, Segoe UI, Arial">

    <UserControl.Resources>
        <SolidColorBrush x:Key="ForestBrush" Color="#1B4D2B"/>
        <SolidColorBrush x:Key="ForestHoverBrush" Color="#225933"/>
        <SolidColorBrush x:Key="YellowBrush" Color="#FFC926"/>
        <SolidColorBrush x:Key="InkBrush" Color="#1E293B"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderBrushLight" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TableHeaderBg" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="RowHoverBg" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="PillGreenBg" Color="#DCFCE7"/>
        <SolidColorBrush x:Key="PillGreenText" Color="#166534"/>
        <SolidColorBrush x:Key="PillBlueBg" Color="#EFF6FF"/>
        <SolidColorBrush x:Key="PillBlueText" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="PillPurpleBg" Color="#F5F3FF"/>
        <SolidColorBrush x:Key="PillPurpleText" Color="#7C3AED"/>
        <SolidColorBrush x:Key="PillRedBg" Color="#FEE2E2"/>
        <SolidColorBrush x:Key="PillRedText" Color="#991B1B"/>

        <!-- Soft Card Drop Shadow -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="12" Direction="270"
                          Opacity="0.06" ShadowDepth="2" Color="#0F172A"/>

        <Style x:Key="ActionPillButton" TargetType="Button">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="{StaticResource ForestBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Square icon button (edit) -->
        <Style x:Key="IconActionButton" TargetType="Button" BasedOn="{StaticResource ActionPillButton}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <!-- Enable/Disable icon (power): red when active (click to disable), green when inactive (click to enable) -->
        <Style x:Key="ToggleStatusIconButton" TargetType="Button" BasedOn="{StaticResource IconActionButton}">
            <Setter Property="Foreground" Value="{StaticResource PillRedText}"/>
            <Setter Property="ToolTip" Value="Disable account"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource PillGreenText}"/>
                    <Setter Property="ToolTip" Value="Enable account"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Data row: unified look + hover highlight -->
        <Style x:Key="RowBorder" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushLight}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="16,12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource RowHoverBg}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,32">
            <!-- Header section -->
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="👥 " FontSize="28"/>
                        <TextBlock Text="User Management"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource ForestBrush}"/>
                    </StackPanel>
                    <TextBlock Text="Administer store user accounts, system roles (Admin, Cashier), and access controls."
                               FontSize="15" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🔄 Refresh"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource ActionPillButton}"
                            Margin="0,0,10,0"/>

                    <Button Content="+ Add New Cashier"
                            Command="{Binding AddUserCommand}"
                            Background="{StaticResource ForestBrush}"
                            Foreground="White"
                            FontWeight="SemiBold"
                            FontSize="14"
                            Padding="18,10"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="{StaticResource ForestHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Notification banner if present -->
            <Border Background="#ECFDF5" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6"
                    Padding="14,12" Margin="0,0,0,18">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NotificationMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔔 " FontSize="16"/>
                    <TextBlock Text="{Binding NotificationMessage}" FontSize="14" FontWeight="SemiBold" Foreground="#065F46" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Metrics grid (4 cards in UniformGrid, 4 columns) -->
            <UniformGrid Columns="4" Margin="0,0,0,22">

                <!-- Card 1: Total Accounts (Blue stripe #2563EB) -->
                <Border CornerRadius="10" Background="White" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" Effect="{StaticResource CardShadow}" Margin="0,0,16,0">
                    <Grid>
                        <!-- Top Accent Stripe -->
                        <Border Height="4" Background="#2563EB" VerticalAlignment="Top" CornerRadius="10,10,0,0"/>

                        <StackPanel Margin="20,18,20,16">
                            <Grid>
                                <TextBlock Text="Total Accounts" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                                <Border HorizontalAlignment="Right" Background="{StaticResource PillBlueBg}" CornerRadius="10" Padding="8,2">
                                    <TextBlock Text="System" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource PillBlueText}"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding TotalUsersCount}" FontSize="25" FontWeight="Bold" Foreground="{StaticResource InkBrush}" Margin="0,10,0,3"/>
                            <TextBlock Text="Provisioned user logins" FontSize="12" FontWeight="Medium" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Card 2: Administrators (Purple stripe #7C3AED) -->
                <Border CornerRadius="10" Background="White" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" Effect="{StaticResource CardShadow}" Margin="0,0,16,0">
                    <Grid>
                        <!-- Top Accent Stripe -->
                        <Border Height="4" Background="#7C3AED" VerticalAlignment="Top" CornerRadius="10,10,0,0"/>

                        <StackPanel Margin="20,18,20,16">
                            <Grid>
                                <TextBlock Text="Administrators" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                                <Border HorizontalAlignment="Right" Background="{StaticResource PillPurpleBg}" CornerRadius="10" Padding="8,2">
                                    <TextBlock Text="Full Access" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource PillPurpleText}"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding AdminCount}" FontSize="25" FontWeight="Bold" Foreground="#7C3AED" Margin="0,10,0,3"/>
                            <TextBlock Text="Store managers &amp; admins" FontSize="12" FontWeight="Medium" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Card 3: Cashiers (Forest stripe #1B4D2B) -->
                <Border CornerRadius="10" Background="White" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" Effect="{StaticResource CardShadow}" Margin="0,0,16,0">
                    <Grid>
                        <!-- Top Accent Stripe -->
                        <Border Height="4" Background="{StaticResource ForestBrush}" VerticalAlignment="Top" CornerRadius="10,10,0,0"/>

                        <StackPanel Margin="20,18,20,16">
                            <Grid>
                                <TextBlock Text="Cashiers" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                                <Border HorizontalAlignment="Right" Background="{StaticResource PillGreenBg}" CornerRadius="10" Padding="8,2">
                                    <TextBlock Text="POS Only" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource PillGreenText}"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding CashierCount}" FontSize="25" FontWeight="Bold" Foreground="{StaticResource ForestBrush}" Margin="0,10,0,3"/>
                            <TextBlock Text="Shift checkout operators" FontSize="12" FontWeight="SemiBold" Foreground="#10B981"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Card 4: Active accounts (Emerald stripe #10B981) -->
                <Border CornerRadius="10" Background="White" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" Effect="{StaticResource CardShadow}" Margin="0">
                    <Grid>
                        <!-- Top Accent Stripe -->
                        <Border Height="4" Background="#10B981" VerticalAlignment="Top" CornerRadius="10,10,0,0"/>

                        <StackPanel Margin="20,18,20,16">
                            <Grid>
                                <TextBlock Text="Active Status" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                                <Border HorizontalAlignment="Right" Background="{StaticResource PillGreenBg}" CornerRadius="10" Padding="8,2">
                                    <TextBlock Text="Enabled" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource PillGreenText}"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding ActiveCount}" FontSize="25" FontWeight="Bold" Foreground="#10B981" Margin="0,10,0,3"/>
                            <TextBlock Text="Ready to authenticate" FontSize="12" FontWeight="SemiBold" Foreground="#059669"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- Search and Filter Bar -->
            <Border Background="{StaticResource CardBackground}"
                    BorderBrush="{StaticResource BorderBrushLight}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18,14"
                    Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Search"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}"
                               Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔍" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <Grid Width="340">
                            <TextBox x:Name="SearchBox"
                                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="15"
                                     Padding="8,7"
                                     VerticalContentAlignment="Center"
                                     BorderBrush="{StaticResource BorderBrushLight}"
                                     BorderThickness="1"/>

                            <!-- Placeholder: visible only while the box is empty -->
                            <TextBlock Text="Search User ID or Username"
                                       FontSize="15"
                                       Foreground="#94A3B8"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Button Content="Clear"
                                Command="{Binding ClearSearchCommand}"
                                Style="{StaticResource ActionPillButton}"
                                Margin="10,0,0,0"/>
                    </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="{Binding FilteredUsers.Count, StringFormat='Showing {0} user account(s)'}"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Bottom"
                               Margin="0,0,0,10"/>
                </Grid>
            </Border>

            <!-- Users List Table Card -->
            <Border Background="{StaticResource CardBackground}"
                    BorderBrush="{StaticResource BorderBrushLight}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="0"
                    Margin="0,0,0,8"
                    Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <!-- Table Header (columns sit close together, no big gaps) -->
                    <Border Background="{StaticResource TableHeaderBg}"
                            CornerRadius="10,10,0,0"
                            BorderBrush="{StaticResource BorderBrushLight}"
                            BorderThickness="0,0,0,1"
                            Padding="16,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="USER ID"    Style="{StaticResource HeaderText}"/>
                            <TextBlock Grid.Column="1" Text="USERNAME"   Style="{StaticResource HeaderText}"/>
                            <TextBlock Grid.Column="2" Text="ROLE"       Style="{StaticResource HeaderText}"/>
                            <TextBlock Grid.Column="3" Text="STATUS"     Style="{StaticResource HeaderText}"/>
                            <TextBlock Grid.Column="4" Text="LAST LOGIN" Style="{StaticResource HeaderText}"/>
                            <TextBlock Grid.Column="5" Text="ACTION"     Style="{StaticResource HeaderText}"/>
                        </Grid>
                    </Border>

                    <!-- User rows -->
                    <ItemsControl ItemsSource="{Binding FilteredUsers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RowBorder}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="210"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- User ID: avatar + ID -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="38" Height="38"
                                                    Background="{StaticResource ForestBrush}"
                                                    CornerRadius="19">
                                                <TextBlock Text="{Binding Initial}"
                                                           FontWeight="Bold" FontSize="16"
                                                           Foreground="{StaticResource YellowBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding Id, StringFormat='{}#{0:D4}'}"
                                                       FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </StackPanel>

                                        <!-- Username & Full Name -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Username}"
                                                       FontWeight="Bold" FontSize="15"
                                                       Foreground="{StaticResource InkBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding FullName}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,1,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding FullName}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Role Badge -->
                                        <Border Grid.Column="2" CornerRadius="6" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource PillBlueBg}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RoleBadge}" Value="ADMIN">
                                                            <Setter Property="Background" Value="{StaticResource PillPurpleBg}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding RoleBadge}" FontSize="12.5" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource PillBlueText}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RoleBadge}" Value="ADMIN">
                                                                <Setter Property="Foreground" Value="{StaticResource PillPurpleText}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <!-- Status Badge -->
                                        <Border Grid.Column="3" CornerRadius="6" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource PillGreenBg}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Background" Value="{StaticResource PillRedBg}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusText}" FontSize="12.5" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource PillGreenText}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Foreground" Value="{StaticResource PillRedText}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <!-- Last Login -->
                                        <TextBlock Grid.Column="4" Text="{Binding FormattedLastLogin}"
                                                   FontSize="14" Foreground="{StaticResource MutedBrush}"
                                                   VerticalAlignment="Center"/>

                                        <!-- Actions: Edit icon + Enable/Disable -->
                                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource IconActionButton}"
                                                    Content="&#xE70F;"
                                                    ToolTip="Edit account"
                                                    Command="{Binding DataContext.EditUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="0,0,8,0"/>

                                            <Button Style="{StaticResource ToggleStatusIconButton}"
                                                    Content="&#xE7E8;"
                                                    Command="{Binding DataContext.ToggleStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
