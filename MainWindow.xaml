<Window x:Class="OopsGrocery.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OopsGrocery.ViewModels"
        xmlns:views="clr-namespace:OopsGrocery.Views"
        Title="Oops Grocery - Store Workspace"
        Width="1200"
        Height="760"
        MinWidth="1050"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- DataTemplates for Dynamic View Switching -->
        <DataTemplate DataType="{x:Type vm:AdminViewModel}">
            <views:AdminView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CashierViewModel}">
            <views:CashierView />
        </DataTemplate>

        <!-- Color Palette -->
        <SolidColorBrush x:Key="ForestBrush" Color="#1B4D2B"/>
        <SolidColorBrush x:Key="ForestDarkBrush" Color="#133C21"/>
        <SolidColorBrush x:Key="ForestHoverBrush" Color="#225933"/>
        <SolidColorBrush x:Key="ForestActiveBrush" Color="#296D3F"/>
        <SolidColorBrush x:Key="CreamBrush" Color="#F5E6C8"/>
        <SolidColorBrush x:Key="YellowBrush" Color="#FFC926"/>
        <SolidColorBrush x:Key="YellowHoverBrush" Color="#F6BE14"/>
        <SolidColorBrush x:Key="InkBrush" Color="#1E293B"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderBrushLight" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>

        <FontFamily x:Key="SerifFont">Lora, Georgia, Times New Roman</FontFamily>
        <FontFamily x:Key="SansFont">Inter, Segoe UI, Arial</FontFamily>

        <!-- Sidebar Navigation Button Style -->
        <Style x:Key="SidebarNavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource CreamBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="14,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ForestHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active Navigation Button Style -->
        <Style x:Key="SidebarActiveNavButton" TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
            <Setter Property="Background" Value="{StaticResource ForestActiveBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Sign Out Button Style -->
        <Style x:Key="SignOutButton" TargetType="Button">
            <Setter Property="Background" Value="#174225"/>
            <Setter Property="Foreground" Value="#F87171"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#265C38"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D1B1B"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#7F1D1D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT SIDEBAR ================= -->
        <Border Grid.Column="0" Background="{StaticResource ForestBrush}">
            <Grid Margin="18,22,18,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand Section -->
                <StackPanel Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Basket Icon -->
                        <Path Width="34" Height="24" HorizontalAlignment="Left"
                              Stroke="{StaticResource YellowBrush}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M9,13 A8,11.5 0 0 1 25,13
                                    M1.5,13 L32.5,13
                                    M4,13 L7.5,28 L26.5,28 L30,13
                                    M5.5,20.5 L28.5,20.5
                                    M12.5,13 L12.5,28 M17,13 L17,28 M21.5,13 L21.5,28"
                              Stretch="Fill" Margin="0,0,10,0"/>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="OOPs Grocery"
                                       FontFamily="{StaticResource SerifFont}"
                                       FontSize="19" FontWeight="Bold"
                                       Foreground="{StaticResource CreamBrush}"/>
                            <TextBlock Text="Good groceries. Better days."
                                       FontSize="10.5" Foreground="{StaticResource CreamBrush}" Opacity="0.8"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="#2A643B" Margin="0,18,0,16"/>
                </StackPanel>

                <!-- User Profile Card -->
                <Border Grid.Row="1"
                        Background="{StaticResource ForestDarkBrush}"
                        BorderBrush="#255D37"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,10"
                        Margin="0,0,0,22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Avatar Circle -->
                        <Border Grid.Column="0" Width="34" Height="34"
                                Background="{StaticResource YellowBrush}"
                                CornerRadius="17"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Initial}"
                                       FontWeight="Bold" FontSize="15"
                                       Foreground="{StaticResource ForestBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Username & Role Pill -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="{Binding DisplayName}"
                                       FontWeight="Bold" FontSize="13.5"
                                       Foreground="{StaticResource CreamBrush}"/>
                            <Border Background="{StaticResource ForestBrush}"
                                    CornerRadius="8" Padding="6,1.5"
                                    HorizontalAlignment="Left" Margin="0,3,0,0">
                                <TextBlock Text="{Binding RoleBadge}"
                                           FontSize="9.5" FontWeight="Bold"
                                           Foreground="{StaticResource YellowBrush}"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Navigation Menu Links -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Admin Navigation -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="MANAGEMENT PORTAL"
                                       FontSize="10.5" FontWeight="Bold"
                                       Foreground="{StaticResource CreamBrush}" Opacity="0.6"
                                       Margin="6,0,0,8"/>

                            <Button Content="📊   Dashboard Overview"
                                    Style="{StaticResource SidebarActiveNavButton}"
                                    Command="{Binding SelectNavCommand}" CommandParameter="Dashboard"/>

                            <Button Content="📦   Inventory &amp; Stock"
                                    Style="{StaticResource SidebarNavButton}"
                                    Command="{Binding SelectNavCommand}" CommandParameter="Inventory"/>

                            <Button Content="📑   Customer Orders"
                                    Style="{StaticResource SidebarNavButton}"
                                    Command="{Binding SelectNavCommand}" CommandParameter="Orders"/>

                            <Button Content="👥   User Directory"
                                    Style="{StaticResource SidebarNavButton}"
                                    Command="{Binding SelectNavCommand}" CommandParameter="Users"/>

                            <Button Content="⚙️   Store Settings"
                                    Style="{StaticResource SidebarNavButton}"
                                    Command="{Binding SelectNavCommand}" CommandParameter="Settings"/>
                        </StackPanel>

                        <!-- Cashier Navigation -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCashier}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="CASHIER POS TERMINAL"
                                       FontSize="10.5" FontWeight="Bold"
                                       Foreground="{StaticResource CreamBrush}" Opacity="0.6"
                                       Margin="6,0,0,8"/>

                            <Button Content="📟   POS Register (Live)"
                                    Style="{StaticResource SidebarActiveNavButton}"
                                    Command="{Binding SelectNavCommand}" CommandParameter="Register"/>

                            <Button Content="🧾   Shift Transactions"
                                    Style="{StaticResource SidebarNavButton}"
                                    Command="{Binding SelectNavCommand}" CommandParameter="Transactions"/>

                            <Button Content="💵   Cash Drawer &amp; Drop"
                                    Style="{StaticResource SidebarNavButton}"
                                    Command="{Binding SelectNavCommand}" CommandParameter="CashDrawer"/>

                            <Button Content="🏷️   Item Price Checker"
                                    Style="{StaticResource SidebarNavButton}"
                                    Command="{Binding SelectNavCommand}" CommandParameter="PriceCheck"/>

                            <Button Content="⏸️   Hold / Recall Sale"
                                    Style="{StaticResource SidebarNavButton}"
                                    Command="{Binding SelectNavCommand}" CommandParameter="HoldSale"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Sidebar Footer: Status & Sign Out -->
                <StackPanel Grid.Row="3" Margin="0,16,0,0">
                    <!-- DB Status pill -->
                    <Border Background="{StaticResource ForestDarkBrush}"
                            BorderBrush="#255D37"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,6"
                            Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="#10B981" Margin="0,0,7,0"/>
                            <TextBlock Text="MariaDB: 3306 Connected" FontSize="11" Foreground="{StaticResource CreamBrush}" Opacity="0.9"/>
                        </StackPanel>
                    </Border>

                    <!-- Sign Out Button -->
                    <Button Content="🚪  Sign Out"
                            Style="{StaticResource SignOutButton}"
                            Command="{Binding SignOutCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= RIGHT CONTENT AREA ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0"
                    Background="{StaticResource CardBackground}"
                    BorderBrush="{StaticResource BorderBrushLight}"
                    BorderThickness="0,0,0,1"
                    Padding="28,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Welcome greeting -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Welcome, " FontSize="17" FontWeight="Bold" Foreground="{StaticResource InkBrush}"/>
                            <TextBlock Text="{Binding DisplayName}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource ForestBrush}"/>
                            <TextBlock Text=" 👋" FontSize="16"/>
                        </StackPanel>
                        <TextBlock Text="{Binding RoleGreeting}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Top Bar Right Controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Search Box -->
                        <Border Background="#F1F5F9"
                                BorderBrush="{StaticResource BorderBrushLight}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Height="34"
                                Width="220"
                                Padding="10,0"
                                Margin="0,0,14,0">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="12"
                                         VerticalAlignment="Center"
                                         Foreground="{StaticResource InkBrush}"
                                         Tag="Search items..."/>
                            </Grid>
                        </Border>

                        <!-- Date Badge -->
                        <Border Background="#EFF6FF" CornerRadius="8" Padding="12,6">
                            <TextBlock Text="📅 Today: Live Store Sync" FontSize="11.5" FontWeight="SemiBold" Foreground="#1D4ED8"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Dynamic Body View (AdminView or CashierView) -->
            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentViewModel}"
                            Focusable="False"/>
        </Grid>
    </Grid>
</Window>