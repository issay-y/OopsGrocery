<Window x:Class="OopsGrocery.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OopsGrocery.ViewModels"
        xmlns:views="clr-namespace:OopsGrocery.Views"
        xmlns:ctl="clr-namespace:OopsGrocery.Controls"
        Title="Oops Grocery - Store Workspace"
        Width="1280"
        Height="800"
        MinWidth="1050"
        MinHeight="680"
        WindowState="Maximized"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="4"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- DataTemplates for Dynamic View Switching -->
        <DataTemplate DataType="{x:Type vm:AdminViewModel}">
            <views:AdminView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductsInventoryViewModel}">
            <views:ProductsInventoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TransactionsReportsViewModel}">
            <views:TransactionsReportsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UserManagementViewModel}">
            <views:UserManagementView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfileViewModel}">
            <views:ProfileView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CashierViewModel}">
            <views:CashierView />
        </DataTemplate>

        <!-- Color Palette -->
        <SolidColorBrush x:Key="ForestBrush" Color="#1B4D2B"/>
        <SolidColorBrush x:Key="ForestDarkBrush" Color="#133C21"/>
        <SolidColorBrush x:Key="ForestHoverBrush" Color="#225933"/>
        <SolidColorBrush x:Key="ForestActiveBrush" Color="#296D3F"/>
        <SolidColorBrush x:Key="CreamBrush" Color="#F5E6C8"/>
        <SolidColorBrush x:Key="YellowBrush" Color="#FFC926"/>
        <SolidColorBrush x:Key="YellowHoverBrush" Color="#F6BE14"/>
        <SolidColorBrush x:Key="InkBrush" Color="#1E293B"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderBrushLight" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>

        <FontFamily x:Key="SerifFont">Lora, Georgia, Times New Roman</FontFamily>
        <FontFamily x:Key="SansFont">Inter, Segoe UI, Arial</FontFamily>

        <!-- Sidebar Navigation Button Style -->
        <Style x:Key="SidebarNavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource CreamBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="14,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ForestHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active Navigation Button Style -->
        <Style x:Key="SidebarActiveNavButton" TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
            <Setter Property="Background" Value="{StaticResource ForestActiveBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Sign Out Button Style -->
        <Style x:Key="SignOutButton" TargetType="Button">
            <Setter Property="Background" Value="#174225"/>
            <Setter Property="Foreground" Value="#F87171"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#265C38"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D1B1B"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#7F1D1D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Titlebar Control Buttons -->
        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets, Segoe UI Symbol, Arial"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#EF4444"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT SIDEBAR ================= -->
        <Border Grid.Column="0" Background="{StaticResource ForestBrush}">
            <Grid Margin="18,22,18,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand Section -->
                <StackPanel Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Basket Icon -->
                        <Path Width="34" Height="24" HorizontalAlignment="Left"
                              Stroke="{StaticResource YellowBrush}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M9,13 A8,11.5 0 0 1 25,13
                                    M1.5,13 L32.5,13
                                    M4,13 L7.5,28 L26.5,28 L30,13
                                    M5.5,20.5 L28.5,20.5
                                    M12.5,13 L12.5,28 M17,13 L17,28 M21.5,13 L21.5,28"
                              Stretch="Fill" Margin="0,0,10,0"/>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="OOPs Grocery"
                                       FontFamily="{StaticResource SerifFont}"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource CreamBrush}"/>
                            <TextBlock Text="Good groceries. Better days."
                                       FontSize="12" Foreground="{StaticResource CreamBrush}" Opacity="0.8"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="#2A643B" Margin="0,18,0,16"/>
                </StackPanel>

                <!-- User Profile Card (Clickable to open ViewProfileWindow pop-up dialog) -->
                <Button Grid.Row="1"
                        Command="{Binding OpenProfileDialogCommand}"
                        ToolTip="Click to view staff profile, credentials &amp; role trivia"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Cursor="Hand"
                        Margin="0,0,0,22">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ProfileCardBorder"
                                    Background="{StaticResource ForestDarkBrush}"
                                    BorderBrush="#255D37"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Avatar Circle -->
                                    <Border Grid.Column="0" Width="38" Height="38"
                                            Background="{StaticResource YellowBrush}"
                                            CornerRadius="19"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Initial}"
                                                   FontWeight="Bold" FontSize="17"
                                                   Foreground="{StaticResource ForestBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Username & Role Pill -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="Bold" FontSize="15"
                                                   Foreground="{StaticResource CreamBrush}"/>
                                        <Border Background="{StaticResource ForestBrush}"
                                                CornerRadius="8" Padding="7,2"
                                                HorizontalAlignment="Left" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding RoleBadge}"
                                                       FontSize="11" FontWeight="Bold"
                                                       Foreground="{StaticResource YellowBrush}"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Subtle pop-up indicator icon -->
                                    <TextBlock Grid.Column="2" Text="ⓘ"
                                               FontSize="13" FontWeight="Bold"
                                               Foreground="{StaticResource CreamBrush}"
                                               Opacity="0.6"
                                               VerticalAlignment="Center"
                                               Margin="4,0,2,0"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ProfileCardBorder" Property="Background" Value="{StaticResource ForestHoverBrush}"/>
                                    <Setter TargetName="ProfileCardBorder" Property="BorderBrush" Value="#388E3C"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Navigation Menu Links -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Admin Navigation -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="ADMINISTRATION PORTAL"
                                       FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource CreamBrush}" Opacity="0.6"
                                       Margin="6,0,0,8"/>

                            <!-- 1. Dashboard -->
                            <Button Content="📊   Dashboard"
                                    Command="{Binding SelectNavCommand}" CommandParameter="Dashboard">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDashboardActive}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource ForestActiveBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- 2. Products & Inventory -->
                            <Button Content="📦   Products &amp; Inventory"
                                    Command="{Binding SelectNavCommand}" CommandParameter="Products">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsProductsActive}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource ForestActiveBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- 3. Transactions & Reports -->
                            <Button Content="📑   Transactions &amp; Reports"
                                    Command="{Binding SelectNavCommand}" CommandParameter="Transactions">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTransactionsActive}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource ForestActiveBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- 4. User Management -->
                            <Button Content="👥   User Management"
                                    Command="{Binding SelectNavCommand}" CommandParameter="UserManagement">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUserManagementActive}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource ForestActiveBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                        </StackPanel>

                        <!-- Cashier Navigation -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCashier}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="CASHIER PORTAL"
                                       FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource CreamBrush}" Opacity="0.6"
                                       Margin="6,0,0,8"/>

                            <!-- Only one main navigation item: New Order / POS -->
                            <Button Content="🛒   New Order / POS"
                                    Style="{StaticResource SidebarActiveNavButton}"
                                    Command="{Binding SelectNavCommand}" CommandParameter="NewOrderPOS"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Sidebar Footer: Status & Sign Out -->
                <StackPanel Grid.Row="3" Margin="0,16,0,0">
                    <!-- DB Status pill -->
                    <Border Background="{StaticResource ForestDarkBrush}"
                            BorderBrush="#255D37"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,7"
                            Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0"/>
                            <TextBlock Text="MariaDB: 3306 Connected" FontSize="12.5" Foreground="{StaticResource CreamBrush}" Opacity="0.9"/>
                        </StackPanel>
                    </Border>

                    <!-- Logout Button -->
                    <Button Content="🚪  Logout"
                            Style="{StaticResource SignOutButton}"
                            Command="{Binding SignOutCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= RIGHT CONTENT AREA ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0"
                    Background="{StaticResource CardBackground}"
                    BorderBrush="{StaticResource BorderBrushLight}"
                    BorderThickness="0,0,0,1"
                    Padding="28,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Welcome greeting -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Welcome, " FontSize="20" FontWeight="Bold" Foreground="{StaticResource InkBrush}"/>
                            <TextBlock Text="{Binding DisplayName}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource ForestBrush}"/>
                            <TextBlock Text=" 👋" FontSize="19"/>
                        </StackPanel>
                        <TextBlock Text="{Binding RoleGreeting}" FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Top Bar Right Controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Live Date & Time Badge -->
                        <Border Background="#EFF6FF" CornerRadius="8" Padding="14,8" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📅" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <ctl:LiveClockTextBlock FontSize="14"
                                                        FontWeight="SemiBold"
                                                        Foreground="#1D4ED8"
                                                        VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Window Control Buttons (Minimize, Maximize/Restore, Close) -->
                        <Border Background="#F1F5F9" CornerRadius="8" Padding="3,2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource WindowControlButton}"
                                        Content="&#xE921;"
                                        ToolTip="Minimize"
                                        Click="MinimizeButton_OnClick"/>
                                <Button Style="{StaticResource WindowControlButton}"
                                        x:Name="RestoreMaximizeBtn"
                                        Content="&#xE923;"
                                        ToolTip="Restore Down"
                                        Click="MaximizeRestoreButton_OnClick"
                                        Margin="2,0"/>
                                <Button Style="{StaticResource WindowCloseButton}"
                                        Content="&#xE8BB;"
                                        ToolTip="Close Workspace"
                                        Click="CloseButton_OnClick"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Dynamic Body View (AdminView or CashierView) -->
            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentViewModel}"
                            Focusable="False"/>
        </Grid>
    </Grid>
</Window>
